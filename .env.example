DATABASE_URL=postgresql+psycopg://audia:YOUR_PASSWORD@localhost:5432/audia
SECRET_KEY=replace-with-a-long-random-secret
APP_URL=http://localhost:5000
COOKIE_SECURE=false
FLASK_DEBUG=0
# smtp for email delivery; file for local password-reset messages in instance/mail.
MAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@audia.local
