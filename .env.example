# Copy to .env and supply your local PostgreSQL credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=audia_db
DB_USER=audia_user
DB_PASSWORD=
# Alternative to DB_*; leave blank when using the fields above.
DATABASE_URL=
SECRET_KEY=
COOKIE_SECURE=false
# Local server port (5000 may be reserved by Windows).
PORT=5001
APP_URL=http://localhost:5001
FLASK_DEBUG=0
# Opt in on a local demonstration server to show failure/timeout test scenarios.
DEMO_PAYMENT_TEST_CONTROLS=false
MAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set only behind a known reverse proxy that overwrites forwarded headers.
TRUSTED_PROXY_HOPS=0
# Check edited templates on each request; disable explicitly for packaged deployments.
TEMPLATES_AUTO_RELOAD=true
