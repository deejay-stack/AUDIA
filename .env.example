# Copy to .env and supply your local PostgreSQL credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=audia_db
DB_USER=audia_user
DB_PASSWORD=
# Alternative to DB_*; leave blank when using the fields above.
DATABASE_URL=
SECRET_KEY=
COOKIE_SECURE=false
APP_URL=http://localhost:5000
FLASK_DEBUG=0
MAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
